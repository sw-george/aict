CSS 样式
Css.navbar {
    display: flex;
    align-items: center;
}

.main-nav {
    width: fit-content;
    max-width: 100%;
    position: relative;
    background: var(--main-nav-bg);
    border-radius: var(--nav-border-radius);
    padding: 0.5rem 1rem;
    transition: background-color 0.3s ease;
}

.main-nav:hover {
    background: var(--main-nav-bg-hover);
}

.main-nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 1rem;
    position: relative;
}

.main-nav li {
    position: relative;
}

.main-nav a {
    position: relative;
    display: block;
    padding: 0.5rem 1rem;
    color: var(--nav-link-color);
    text-decoration: none;
    z-index: 1;
    transition: color var(--nav-trans-duration) var(--nav-trans-easing);
}

/* 水珠指示器 */
.nav-indicator {
    position: absolute;
    top: 0;
    left: 0;
    width: 0;
    height: calc(100% - 8px);
    top: 4px;
    background: var(--nav-indicator-hover);
    border-radius: var(--nav-border-radius);
    transition:
        transform var(--nav-trans-duration) var(--nav-trans-easing),
        width var(--nav-trans-duration) var(--nav-trans-easing),
        background-color 0.3s ease;
    z-index: 0;
}

/* 子菜单 */
.sub-menu {
    display: block;
    position: absolute;
    top: 100%;
    left: 0;
    background: var(--subnav-bg, var(--main-nav-bg));
    border-radius: var(--subnav-border-radius);
    padding: var(--spacing-sm) 0;
    list-style: none;
    margin: 0;
    min-width: 160px;
    box-shadow: 0 4px 8px rgba(0,0,0,0.15);
    opacity: 0;
    transform: translateY(10px);
    pointer-events: none;
    transition: opacity 0.3s ease, transform 0.3s ease;
    z-index: 10;
}

.sub-menu li {
    position: relative;
    overflow: hidden;
}

.sub-menu li::before {
    content: "";
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: var(--nav-indicator-hover);
    transition: left 0.3s ease;
    z-index: 0;
}

.sub-menu li:hover::before {
    left: 0;
}

.sub-menu li a {
    position: relative;
    z-index: 1;
    display: block;
    padding: var(--spacing-sm) var(--spacing-lg);
    color: var(--nav-link-color);
    text-decoration: none;
    white-space: nowrap;
    border-radius: var(--subnav-border-radius);
}

.sub-menu li a:hover {
    color: var(--primary-color);
}

/* hover 父菜单时显示子菜单 */
.main-nav li:hover > .sub-menu {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
}

/* 按钮组固定在右侧 */
.header-actions {
    margin-left: auto;
    display: flex;
    gap: var(--spacing-md);
}


JS 控制水珠滑动
Javascriptdocument.addEventListener("DOMContentLoaded", () => {
    const nav = document.querySelector(".main-nav");
    const indicator = nav.querySelector(".nav-indicator");
    const links = nav.querySelectorAll("> ul > li > a"); // 只选一级菜单

    links.forEach(link => {
        link.addEventListener("mouseenter", e => {
            const rect = e.target.getBoundingClientRect();
            const navRect = nav.getBoundingClientRect();
            indicator.style.width = `${rect.width}px`;
            indicator.style.transform = `translateX(${rect.left - navRect.left}px)`;
        });
    });

    nav.addEventListener("mouseleave", () => {
        indicator.style.width = `0px`;
    });
});


