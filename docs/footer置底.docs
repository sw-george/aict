js/sidebar.js
Javascript// 手风琴展开/收起
document.querySelectorAll('.accordion').forEach(button => {
  button.addEventListener('click', () => {
    // 切换当前按钮的激活状态
    button.classList.toggle('active');

    // 获取对应的子菜单
    const submenu = button.nextElementSibling;

    // 展开或收起
    if (submenu.style.display === 'block') {
      submenu.style.display = 'none';
    } else {
      submenu.style.display = 'block';
    }
  });
});


🔹 功能说明

绑定事件：给每个 .accordion 按钮绑定 click 事件。
切换样式：点击时切换 .active 类（方便在 CSS 中做不同的样式，比如背景色变化）。
展开/收起逻辑：通过 submenu.style.display 判断当前状态，切换为 block 或 none。


🔹 如果想要“只展开一个”的效果（手风琴互斥）
如果你希望同时只能展开一个菜单，可以改成这样：
Javascriptdocument.querySelectorAll('.accordion').forEach(button => {
  button.addEventListener('click', () => {
    // 收起所有菜单
    document.querySelectorAll('.accordion').forEach(btn => {
      if (btn !== button) {
        btn.classList.remove('active');
        btn.nextElementSibling.style.display = 'none';
      }
    });

    // 切换当前菜单
    button.classList.toggle('active');
    const submenu = button.nextElementSibling;
    submenu.style.display = submenu.style.display === 'block' ? 'none' : 'block';
  });
});

这样点击一个菜单时，其他菜单会自动收起。

