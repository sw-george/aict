好的 👍
那我帮你在刚才的导航指示器版本上，加上 “当前选中菜单高亮保持” 功能：

点击某个菜单（父菜单或普通菜单）后，指示器会固定在该菜单下方。
鼠标移开导航区域，指示器会回到当前选中菜单的位置。
子菜单点击后，也会把父菜单设为选中项（常见导航逻辑）。


完整可运行示例（带选中保持）
Html<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<title>导航指示器示例 - 选中保持</title>
<style>
  body { font-family: sans-serif; }
  nav {
    position: relative;
    background: #f5f5f5;
    padding: 10px 0;
  }
  nav ul {
    list-style: none;
    display: flex;
    margin: 0;
    padding: 0;
  }
  nav li {
    position: relative;
    margin: 0 20px;
  }
  nav a {
    text-decoration: none;
    color: #333;
    padding: 5px;
    display: inline-block;
  }
  .submenu {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    background: #fff;
    border: 1px solid #ccc;
    padding: 5px 0;
  }
  .submenu li {
    margin: 0;
  }
  .submenu a {
    padding: 5px 15px;
    display: block;
  }
  li.has-submenu:hover .submenu {
    display: block;
  }
  .indicator {
    position: absolute;
    bottom: 0;
    height: 2px;
    background: red;
    transition: all 0.3s ease;
    opacity: 0;
  }
</style>
</head>
<body>

<nav class="nav">
  <ul>
    <li class="nav-item has-submenu">
      <a href="#">父菜单 1</a>
      <ul class="submenu">
        <li><a href="#">子菜单 1-1</a></li>
        <li><a href="#">子菜单 1-2</a></li>
      </ul>
    </li>
    <li class="nav-item"><a href="#">菜单 2</a></li>
    <li class="nav-item"><a href="#">菜单 3</a></li>
  </ul>
  <div class="indicator"></div>
</nav>

<script>
const nav = document.querySelector('.nav');
const indicator = document.querySelector('.indicator');
const navLinks = document.querySelectorAll('.nav-item > a');

let activeLink = null; // 当前选中菜单

// 移动指示器到指定链接
function moveIndicatorTo(link) {
  const rect = link.getBoundingClientRect();
  const navRect = nav.getBoundingClientRect();
  indicator.style.width = `${rect.width}px`;
  indicator.style.transform = `translateX(${rect.left - navRect.left}px)`;
  indicator.style.opacity = 1;
}

// 隐藏指示器
function hideIndicator() {
  indicator.style.opacity = 0;
}

// 遍历每个导航链接
navLinks.forEach(link => {
  const parentLi = link.parentElement;
  const submenu = parentLi.querySelector('.submenu');

  // 鼠标进入父菜单链接
  link.addEventListener('mouseenter', () => {
    moveIndicatorTo(link);
  });

  // 鼠标离开父菜单链接（如果没有子菜单才隐藏）
  link.addEventListener('mouseleave', () => {
    if (!submenu && !activeLink) hideIndicator();
  });

  // 如果有子菜单，进入子菜单时隐藏父菜单指示器
  if (submenu) {
    submenu.addEventListener('mouseenter', () => {
      hideIndicator();
    });

    // 离开子菜单后不恢复父菜单指示器
    submenu.addEventListener('mouseleave', () => {
      if (activeLink) {
        moveIndicatorTo(activeLink);
      } else {
        hideIndicator();
      }
    });

    // 子菜单点击时，把父菜单设为选中项
    submenu.querySelectorAll('a').forEach(subLink => {
      subLink.addEventListener('click', e => {
        e.preventDefault();
        activeLink = link; // 父菜单作为选中项
        moveIndicatorTo(activeLink);
      });
    });
  }

  // 点击菜单时设置为选中项
  link.addEventListener('click', e => {
    e.preventDefault();
    activeLink = link;
    moveIndicatorTo(activeLink);
  });
});

// 鼠标离开整个导航时，恢复到选中项
nav.addEventListener('mouseleave', () => {
  if (activeLink) {
    moveIndicatorTo(activeLink);
  } else {
    hideIndicator();
  }
});
</script>

</body>
</html>


功能说明

点击菜单 → 该菜单成为当前选中项，指示器固定在它下方。
鼠标移开导航 → 指示器回到当前选中项位置。
子菜单点击 → 父菜单成为选中项（常见导航逻辑）。
进入子菜单 → 父菜单指示器隐藏，离开子菜单后恢复到选中项（如果有）。


如果你愿意，我还可以帮你加一个 “初始默认选中项” 的功能，比如页面加载时默认选中第一个菜单，这样用户一进来就有指示器效果。
