                        <li><a href="#">产品 B</a></li>
                        <li><a href="#">产品 C</a></li>
                    </ul>
                </li>
                <li><a href="#">服务</a></li>
                <li><a href="#">关于</a></li>
            </ul>
            <span class="nav-indicator"></span>
        </nav>

